{
  "name": "lama-school-management-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop wrapper for the School Management System",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.lamadev.schoolmanagement",
    "productName": "School Management",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@45.3.3": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "@electron/universal": "3.0.6",
    "app-builder-lib": {
      "minimatch": "11.0.8"
    }
  }
}
