generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id                                String                   @id
  username                          String                   @unique
  name                              String
  surname                           String
  email                             String?                  @unique
  phone                             String?                  @unique
  address                           String
  img                               String?
  bloodType                         String
  sex                               UserSex
  createdAt                         DateTime                 @default(now())
  parentId                          String
  classId                           Int
  gradeId                           Int
  birthday                          DateTime
  search_vector                     Unsupported("tsvector")?
  isArchived                        Boolean                  @default(false)
  archivedAt                        DateTime?
  allergyDetails                    String?
  alternativeEmergencyContactNumber String?
  alternativeEmergencyContactPerson String?
  correctiveGlassesDetails          String?
  declarationDate                   DateTime?
  declarationName                   String?
  department                        Department?
  emergencyContactNumber            String?
  emergencyContactPerson            String?
  fitnessDetails                    String?
  gpsAddress                        String?
  hasAllergies                      Boolean                  @default(false)
  hasHearingDifficulties            Boolean                  @default(false)
  hearingDetails                    String?
  knownMedicalConditions            String?
  languagesSpoken                   String?
  nationality                       String?
  otherIssues                       String?
  otherNames                        String?
  physicallyFitForSports            Boolean                  @default(true)
  previousClass                     String?
  previousSchoolName                String?
  reasonForTransfer                 String?
  religion                          String?
  wearsCorrectiveGlasses            Boolean                  @default(false)
  yearsAttended                     Int?
  attendances                       Attendance[]
  busRegistrations                  BusRegistration[]
  results                           Result[]
  class                             Class                    @relation(fields: [classId], references: [id])
  grade                             Grade                    @relation(fields: [gradeId], references: [id])
  parent                            Parent                   @relation(fields: [parentId], references: [id])
  feeAssignments                    StudentFeeAssignment[]
  termlyReports                     TermlyReport[]
  transportRequests                 TransportRequest[]
}

model Teacher {
  id                  String                   @id
  username            String                   @unique
  name                String
  surname             String
  email               String?                  @unique
  phone               String?                  @unique
  address             String
  img                 String?
  bloodType           String
  sex                 UserSex
  createdAt           DateTime                 @default(now())
  birthday            DateTime
  search_vector       Unsupported("tsvector")?
  isArchived          Boolean                  @default(false)
  archivedAt          DateTime?
  attendances         Attendance[]
  assignedClasses    Class[]                  @relation("TeacherAssignedClasses")
  classes             Class[]
  examQuestionUploads ExamQuestionUpload[]
  invigilatedExams    Exam[]                   @relation("ExamInvigilators")
  lessons             Lesson[]
  subjects            Subject[]                @relation("SubjectToTeacher")
}

model Parent {
  id                String                   @id
  username          String                   @unique
  name              String
  surname           String
  email             String?                  @unique
  phone             String                   @unique
  address           String
  createdAt         DateTime                 @default(now())
  search_vector     Unsupported("tsvector")?
  occupation        String?
  isArchived        Boolean                  @default(false)
  archivedAt        DateTime?
  bookOrders        BookOrder[]
  busRegistrations  BusRegistration[]
  students          Student[]
  transportRequests TransportRequest[]
}

model SchoolSetting {
  id                  Int      @id @default(autoincrement())
  name                String
  address             String
  telephone           String
  location            String
  email               String
  logoUrl             String?
  headteacherSignature String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Message {
  id            Int         @id @default(autoincrement())
  senderId      String
  senderRole    UserRole
  recipientId   String
  recipientRole UserRole
  text          String
  type          MessageType @default(MESSAGE)
  createdAt     DateTime    @default(now())
  readAt        DateTime?
}

model User {
  id        String    @id
  username  String?   @unique
  email     String?   @unique
  password  String?
  role      String
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  sessions  Session[]
}

model Session {
  id        String    @id @default(cuid())
  token     String?   @unique
  userId    String?
  expiresAt DateTime  @db.Timestamptz(6)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  ip        String?
  userAgent String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PasswordChangeRequest {
  id              Int                  @id @default(autoincrement())
  requestedById   String
  requestedByRole UserRole
  requestedAt     DateTime             @default(now())
  newPassword     String
  status          PasswordChangeStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedById    String?
  reviewComment   String?
}

model Grade {
  id       Int          @id @default(autoincrement())
  level    GradingLevel @unique
  label    String?
  classess Class[]
  students Student[]
  subjects Subject[]
}

model Class {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  capacity          Int
  supervisorId        String?
  supervisorSignature String?
  gradeId           Int
  gradingLevel      GradingLevel       @default(PRIMARY)
  announcements     Announcement[]
  books             Book[]
  busRegistrations  BusRegistration[]
  grade             Grade              @relation(fields: [gradeId], references: [id])
  supervisor        Teacher?           @relation(fields: [supervisorId], references: [id])
  assignedTeachers  Teacher[]          @relation("TeacherAssignedClasses")
  events            Event[]
  feeSchedules      FeeSchedule[]
  lessons           Lesson[]
  students          Student[]
  termlyReports     TermlyReport[]
  transportRequests TransportRequest[]
  subjects          Subject[]          @relation("ClassToSubject")
}

model Book {
  id              Int             @id @default(autoincrement())
  title           String
  classId         Int?
  priceCedis      Decimal         @db.Decimal(12, 2)
  quantity        Int
  supplierName    String
  supplierContact String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  publication     String          @default("")
  class           Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  orderItems      BookOrderItem[]
}

model BookOrder {
  id         Int             @id @default(autoincrement())
  parentId   String
  status     BookOrderStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  pickupCode String?         @unique
  parent     Parent          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  items      BookOrderItem[]
}

model BookOrderItem {
  id       Int       @id @default(autoincrement())
  orderId  Int
  bookId   Int
  quantity Int
  book     Book      @relation(fields: [bookId], references: [id])
  order    BookOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

/// Class-wide fee bill for a term and academic year (admin creates).
model AcademicYear {
  id            Int            @id @default(autoincrement())
  label         String         @unique
  numberOfTerms Int
  isActive      Boolean        @default(false)
  isArchived    Boolean        @default(false)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  terms         AcademicTerm[]
  termlyReports TermlyReport[]
}

model AcademicTerm {
  id             Int          @id @default(autoincrement())
  academicYearId Int
  termNumber     Int
  startDate      DateTime
  endDate        DateTime
  days           Int
  weeks          Int
  holidays       Int          @default(0)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, termNumber])
}

model FeeSchedule {
  id             Int                    @id @default(autoincrement())
  classId        Int
  academicYear   String
  term           FeeTerm
  totalBillCedis Decimal                @db.Decimal(12, 2)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  isArchived     Boolean                @default(false)
  class          Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments    StudentFeeAssignment[]

  @@unique([classId, academicYear, term])
}

/// Per-student obligation for a fee schedule (total bill copied at assignment time).
model StudentFeeAssignment {
  id             Int          @id @default(autoincrement())
  studentId      String
  feeScheduleId  Int
  totalBillCedis Decimal      @db.Decimal(12, 2)
  payments       FeePayment[]
  feeSchedule    FeeSchedule  @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, feeScheduleId])
}

model FeePayment {
  id                     Int                  @id @default(autoincrement())
  studentFeeAssignmentId Int
  amountCedis            Decimal              @db.Decimal(12, 2)
  paidAt                 DateTime             @default(now())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  methodDetails          String?
  paymentMethod          String               @default("cash")
  assignment             StudentFeeAssignment @relation(fields: [studentFeeAssignmentId], references: [id], onDelete: Cascade)
}

model Subject {
  id                Int                       @id @default(autoincrement())
  name              String
  gradeId           Int
  lessons           Lesson[]
  grade             Grade                     @relation(fields: [gradeId], references: [id])
  termlyReportLines TermlyReportSubjectLine[]
  classes           Class[]                   @relation("ClassToSubject")
  teachers          Teacher[]                 @relation("SubjectToTeacher")

  @@unique([gradeId, name])
}

model GradingScaleEntry {
  id        Int          @id @default(autoincrement())
  level     GradingLevel
  minScore  Int
  maxScore  Int
  grade     String
  remark    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TermlyReport {
  id                   Int                       @id @default(autoincrement())
  studentId            String
  classId              Int
  academicYearId       Int
  termNumber           Int
  positionOnRoll       Int?
  totalOnRoll          Int
  totalAttendance      Int                       @default(0)
  vacationDate         DateTime?
  reopeningDate        DateTime?
  overallPercentage    Float?
  overallGrade         String?
  overallRemark        String?
  interest             String?
  conduct              String?
  resultStatus         String?
  supervisorRemarks    String?
  supervisorSignature  String?
  headteacherRemarks   String?
  headteacherSignature String?
  createdById          String?
  isPublished          Boolean                   @default(false)
  publishedAt          DateTime?
  isWithheld           Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  academicYear         AcademicYear              @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class                Class                     @relation(fields: [classId], references: [id], onDelete: Cascade)
  student              Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectLines         TermlyReportSubjectLine[]

  @@unique([studentId, academicYearId, termNumber])
}

model TermlyReportSubjectLine {
  id             Int          @id @default(autoincrement())
  termlyReportId Int
  subjectId      Int
  classScore     Int          @default(0)
  examScore      Int          @default(0)
  totalMarks     Int          @default(0)
  grade          String?
  remark         String?
  lastEditedById String?
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  termlyReport   TermlyReport @relation(fields: [termlyReportId], references: [id], onDelete: Cascade)

  @@unique([termlyReportId, subjectId])
}

model Lesson {
  id                  Int                  @id @default(autoincrement())
  name                String
  day                 Day
  startTime           DateTime
  endTime             DateTime
  subjectId           Int
  classId             Int
  teacherId           String
  assignments         Assignment[]
  exams               Exam[]
  examQuestionUploads ExamQuestionUpload[]
  class               Class                @relation(fields: [classId], references: [id])
  subject             Subject              @relation(fields: [subjectId], references: [id])
  teacher             Teacher              @relation(fields: [teacherId], references: [id])
}

model Exam {
  id         Int      @id @default(autoincrement())
  title      String
  startTime  DateTime
  endTime    DateTime
  lessonId   Int
  isArchived Boolean  @default(false)
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  invigilators Teacher[] @relation("ExamInvigilators")
  results    Result[]
}

model ExamQuestionUpload {
  id                Int                      @id @default(autoincrement())
  documentType      String                   @default("EXAM_QUESTION")
  title             String
  fileName          String
  fileUrl           String
  status            ExamQuestionUploadStatus @default(PENDING)
  lessonId          Int
  uploadedById      String
  approvedBy        String?
  approvedAt        DateTime?
  academicYearLabel String
  termNumber        Int
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  weekNumber        Int                      @default(1)
  lesson            Lesson                   @relation(fields: [lessonId], references: [id])
  uploadedBy        Teacher                  @relation(fields: [uploadedById], references: [id])
}

model Assignment {
  id         Int      @id @default(autoincrement())
  title      String
  startDate  DateTime
  dueDate    DateTime
  lessonId   Int
  isArchived Boolean  @default(false)
  questions  String?
  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  results    Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  score        Int
  examId       Int?
  assignmentId Int?
  studentId    String
  isArchived   Boolean     @default(false)
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  exam         Exam?       @relation(fields: [examId], references: [id])
  student      Student     @relation(fields: [studentId], references: [id])
}

model Attendance {
  id         Int      @id @default(autoincrement())
  date       DateTime
  present    Boolean
  studentId  String?
  isArchived Boolean  @default(false)
  teacherId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  teacher    Teacher? @relation(fields: [teacherId], references: [id])
}

model Bus {
  id            Int               @id @default(autoincrement())
  name          String
  plateNumber   String?
  driverName    String?
  route         String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  locations     BusLocation[]
  registrations BusRegistration[]
}

model BusLocation {
  id         Int      @id @default(autoincrement())
  busId      Int
  driverId   String?
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  reportedAt DateTime @default(now())
  bus        Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
}

model BusRegistration {
  id        Int      @id @default(autoincrement())
  busId     Int
  studentId String
  parentId  String
  classId   Int
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TransportRequest {
  id        Int      @id @default(autoincrement())
  parentId  String
  studentId String
  classId   Int
  routine   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  classId     Int?
  isArchived  Boolean  @default(false)
  class       Class?   @relation(fields: [classId], references: [id])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime
  classId     Int?
  isArchived  Boolean  @default(false)
  class       Class?   @relation(fields: [classId], references: [id])
}

model role_migration_backups {
  backup_id     Int       @id @default(autoincrement())
  user_id       String
  original_role String
  payload       Json
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

enum UserRole {
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum MessageType {
  MESSAGE
  COMPLAINT
}

enum PasswordChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookOrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum FeeTerm {
  TERM_1
  TERM_2
  TERM_3
}

enum Department {
  PRESCHOOL
  PRIMARY
  JHS
}

enum GradingLevel {
  CRECHE
  NURSERY
  KINDERGARTEN
  PRIMARY
  JHS
}

enum ExamQuestionUploadStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}
